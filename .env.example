# ── AI (Google Gemini — free tier recommended) ─────────────────
# Get a free key at https://aistudio.google.com/apikey  (server-side only!)
GEMINI_API_KEY=
# gemini-3.5-flash-lite: fastest reliable free model (Nov 2026).
GEMINI_MODEL=gemini-3.5-flash-lite
# If the main model fails or is overloaded, retry with this one.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional thinking budget (positive number). Leave blank: thinking is slower
# and its tokens count against the output budget, which truncated JSON replies.
GEMINI_THINKING_BUDGET=

# Provider choice: auto (Gemini first, then DeepSeek), gemini, deepseek, local
AI_PROVIDER=auto

# ── Optional alternative: DeepSeek ─────────────────────────────
# Only used when AI_PROVIDER=deepseek or no Gemini key is set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# ── Optional metadata enrichment (posters/ratings) ───────────
# Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=8787
# CircleFTP catalog base (server-side scraping)
CATALOG_BASE=http://hd.circleftp.net
# Detail cache TTL in minutes
DETAIL_TTL_MINUTES=720
