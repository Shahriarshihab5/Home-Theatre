# ── AI (Google Gemini — free tier recommended) ─────────────────
# Get a free key at https://aistudio.google.com/apikey  (server-side only!)
GEMINI_API_KEY=
# gemini-3.5-flash-lite: fastest reliable free model (Nov 2026).
GEMINI_MODEL=gemini-3.5-flash-lite
# If the main model fails or is overloaded, retry with this one.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional thinking budget (positive number). Leave blank: thinking is slower
# and its tokens count against the output budget, which truncated JSON replies.
GEMINI_THINKING_BUDGET=

# Provider choice: auto (Gemini, then the free providers below, then DeepSeek),
# gemini, groq, openrouter, deepseek, or local.
AI_PROVIDER=auto

# How much the AI does:
#   intent (default) — the AI only reads the request and writes a short reply;
#     the app searches its own catalog and ranks the picks. Uses ~10x fewer
#     tokens, so a free quota lasts far longer. The AI never returns a title.
#   full — the AI sees every candidate title and chooses (more tokens).
#   off — never call an AI provider.
AI_MODE=intent

# ── Free AI backups (both need no credit card) ─────────────────────────────
# Groq free plan: 30 requests/min, 1000/day, no card.
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter free models: 20 requests/min, 50/day without any purchase.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Optional alternative: DeepSeek ─────────────────────────────
# Only used when AI_PROVIDER=deepseek or no Gemini key is set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# ── Optional metadata enrichment (posters/ratings) ───────────
# Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=8787
# CircleFTP catalog base (server-side scraping)
CATALOG_BASE=http://hd.circleftp.net
# Detail cache TTL in minutes
DETAIL_TTL_MINUTES=720
